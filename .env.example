# ApoioBusinessCentral environment example
APP_NAME=ApoioBusinessCentral
APP_ENV=local
LOG_LEVEL=INFO

# Jira / JSM
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=change-me
JIRA_SERVICE_DESK_ID=1
JIRA_PROJECT_KEY=ABC

# Confluence
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=service-account@example.com
CONFLUENCE_API_TOKEN=change-me
CONFLUENCE_SPACE_ID=123456
CONFLUENCE_KB_PARENT_ID=123456

# Business Central
BC_TENANT_ID=00000000-0000-0000-0000-000000000000
BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
BC_CLIENT_SECRET=change-me
BC_ENVIRONMENT=Production
BC_API_BASE=https://api.businesscentral.dynamics.com/v2.0

# Webhooks
BC_WEBHOOK_CLIENT_STATE=change-me-random-secret
PUBLIC_WEBHOOK_BASE_URL=https://api.example.com

# IA
AI_MODE=kb_only
AI_PROVIDER=none
AI_MIN_CONFIDENCE=0.75
